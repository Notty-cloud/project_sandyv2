# Frontend (Vite) Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_APP_NAME=Facial Recognition Attendance System

# Backend (Django) Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET_KEY=change-this-in-production
ACCESS_TOKEN_LIFETIME_HOURS=8
LOGIN_LOCKOUT_THRESHOLD=5

# PostgreSQL (required for pgvector face-matching; omit to fall back to SQLite in dev)
DATABASE_URL=postgresql://user:password@localhost:5432/sandy

# Redis (required for rate limiting and token blacklist cache)
REDIS_URL=redis://localhost:6379/0

# Face recognition tuning
FACE_MATCHING_THRESHOLD=0.65
FACE_QUALITY_THRESHOLD=0.6

# Attendance late cutoff (24-hour clock)
ATTENDANCE_CUTOFF_HOUR=7
ATTENDANCE_CUTOFF_MINUTE=10
